# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# one-off DB/maintenance scripts — these have held live credentials before.
# Keep them out of the repo; put throwaway scripts in scripts/local/.
/scripts/local/
*-db.mjs
*-db.js
*-db.py
check_*.js
check_*.py
test_*.js
test_*.py
test-*.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
